##############################################################################
# CxCreditGuard configuration. Copy to .env and fill in. Never commit .env.
# Every variable is read with the CXCG_ prefix.
##############################################################################

# --- Runtime -----------------------------------------------------------------
# development | production. production enforces Secure cookies and HSTS.
CXCG_ENV=production
CXCG_LOG_LEVEL=INFO
# Host and port uvicorn binds to inside the container.
CXCG_HOST=0.0.0.0
CXCG_PORT=8000

# --- Master encryption key (REQUIRED) ----------------------------------------
# 32 raw bytes, base64 encoded. Used to derive per-purpose AES-256-GCM keys that
# encrypt the Checkmarx API key, SMTP credentials, webhook secrets and TOTP
# secrets at rest. Generate one with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes all stored secrets unrecoverable. Rotating it requires
# re-entering the Checkmarx API key and notification secrets.
# Supply EITHER CXCG_MASTER_KEY or CXCG_MASTER_KEY_FILE (a mounted secret file).
CXCG_MASTER_KEY=
#CXCG_MASTER_KEY_FILE=/run/secrets/cxcg_master_key

# --- Database ----------------------------------------------------------------
# SQLite (single node default):
CXCG_DATABASE_URL=sqlite:///./data/cxcreditguard.db
# PostgreSQL (recommended, matches docker-compose):
#CXCG_DATABASE_URL=postgresql+psycopg://cxcg:CHANGE_ME@db:5432/cxcreditguard
# Used only by docker-compose to provision the bundled Postgres service.
POSTGRES_DB=cxcreditguard
POSTGRES_USER=cxcg
POSTGRES_PASSWORD=CHANGE_ME

# --- Utility sessions and cookies --------------------------------------------
# Idle timeout: a session dies this many minutes after its last request.
CXCG_SESSION_IDLE_TTL_MINUTES=60
# Hard cap on session lifetime regardless of activity.
CXCG_SESSION_ABSOLUTE_TTL_HOURS=12
# Leave true unless you terminate TLS somewhere that cannot set Secure cookies.
CXCG_COOKIE_SECURE=true
CXCG_HSTS_ENABLED=true
# Comma separated. Only needed when the SPA is served from a different origin.
CXCG_ALLOWED_ORIGINS=

# --- Login protection --------------------------------------------------------
CXCG_LOGIN_MAX_ATTEMPTS=5
CXCG_LOGIN_LOCKOUT_BASE_SECONDS=30
CXCG_LOGIN_LOCKOUT_MAX_SECONDS=3600
CXCG_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- First run bootstrap -----------------------------------------------------
# Creates the first Admin account on startup if no accounts exist, then is
# ignored. Remove both values from the environment once you have logged in.
CXCG_BOOTSTRAP_ADMIN_USERNAME=
CXCG_BOOTSTRAP_ADMIN_PASSWORD=

# --- Checkmarx One API client ------------------------------------------------
CXCG_CX_REQUEST_TIMEOUT_SECONDS=30
CXCG_CX_MAX_RETRIES=4
CXCG_CX_BACKOFF_BASE_SECONDS=0.5
CXCG_CX_BACKOFF_MAX_SECONDS=20
# Refresh the access token when it has less than this much validity left.
CXCG_CX_TOKEN_REFRESH_MARGIN_SECONDS=300
# OAuth client_id used for the refresh_token grant. Leave as ast-app.
CXCG_CX_CLIENT_ID=ast-app
